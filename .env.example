# Copy this file to .env and add your own Groq API key.
# Get a free key at https://console.groq.com/keys
#
# SpeakMate AI works fully WITHOUT this key — all local NLP features
# (grammar checking, scoring, vocabulary, sentence formation, the NLP
# Analyzer, etc.) run locally. The key only unlocks optional AI-generated
# feedback, explanations, and follow-up interview questions.

GROQ_API_KEY=your_groq_api_key_here
# Optional: override the default Groq model
# GROQ_MODEL=llama-3.1-8b-instant
git init